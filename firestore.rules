rules_version = '2';

// BNP Scorer security rules. Paste into Firebase console > Firestore Database >
// Rules, then Publish (README "Cloud"). Keep this file and the console in step.
//
// Published matches, tournaments and scheduled friendlies are public: anyone
// may read them. Only a signed-in scorer may publish one, as its owner, and
// only that owner may change or delete it. Rules cannot run the scoring
// engine, so the app replays every match defensively; a bad owner can only
// spoil their own documents.
service cloud.firestore {
  match /databases/{database}/documents {

    // A new document names its signed-in creator as owner.
    function createsOwn() {
      return request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // A change comes from the owner and keeps them as owner.
    function changesOwn() {
      return request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function deletesOwn() {
      return request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Who played, for finding a player's matches. Optional, so apps from
    // before it existed still publish.
    function playerIdsOk() {
      return !('playerIds' in request.resource.data)
        || request.resource.data.playerIds is list;
    }

    // The moment the last ball made, which the Functions send to followers.
    // Optional; short text only, so it cannot be used to spam a long push.
    function highlightOk() {
      let h = request.resource.data.get('highlight', null);
      return h == null
        || (h is map && h.seq is int && h.kind is string
          && h.title is string && h.title.size() <= 120
          && h.body is string && h.body.size() <= 200);
    }

    match /matches/{matchId} {
      allow read: if true;

      allow create: if createsOwn()
        && request.resource.data.setup.id == matchId
        && request.resource.data.events is list
        && playerIdsOk()
        && highlightOk();

      allow update: if changesOwn()
        && request.resource.data.setup.id == matchId
        && request.resource.data.events is list
        && playerIdsOk()
        && highlightOk();

      allow delete: if deletesOwn();
    }

    // Who has paid the entry fee never leaves the organiser's phone; refuse a
    // tournament that carries it, whatever sent it.
    match /tournaments/{tournamentId} {
      allow read: if true;

      allow create: if createsOwn()
        && request.resource.data.id == tournamentId
        && request.resource.data.fixtures is list
        && !('paid' in request.resource.data);

      allow update: if changesOwn()
        && request.resource.data.id == tournamentId
        && request.resource.data.fixtures is list
        && !('paid' in request.resource.data);

      allow delete: if deletesOwn();
    }

    match /schedules/{scheduleId} {
      allow read: if true;

      allow create: if createsOwn()
        && request.resource.data.id == scheduleId
        && request.resource.data.startsAt is string;

      allow update: if changesOwn()
        && request.resource.data.id == scheduleId
        && request.resource.data.startsAt is string;

      allow delete: if deletesOwn();
    }

    // Players by mobile number (docs/PLAYER_PROFILES.md). A number is never
    // stored: `phones` is keyed by the lowercase hex SHA-256 of its E.164 text,
    // readable one document at a time by signed-in users and never listed.
    function phoneDocOf(number) {
      return /databases/$(database)/documents/phones/$(hashing.sha256(number).toHexString().lower());
    }

    // The signed-in user confirmed this number by SMS.
    function holdsNumber(phoneId) {
      return request.auth != null
        && request.auth.token.phone_number != null
        && phoneId == hashing.sha256(request.auth.token.phone_number).toHexString().lower();
    }

    // Names and home towns stay short text; styles are short names.
    function profileTextOk(data) {
      return data.name is string && data.name.size() <= 60
        && (!('homeTown' in data) || data.homeTown == null
            || (data.homeTown is string && data.homeTown.size() <= 60));
    }

    // A profile photo is the owner's own upload to the photos Worker.
    function photoOk(data) {
      return !('photoUrl' in data) || data.photoUrl == null
        || (data.photoUrl is string && data.photoUrl.size() <= 300
            && data.photoUrl.matches('https://[^/]+/img/avatars/' + request.auth.uid + '[.]img([?]v=[0-9]+)?'));
    }

    // Anyone may read a profile; only its owner may list their own. A captain
    // creates an invited player (no owner); a player creates their own.
    match /players/{playerId} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.id == playerId
        && profileTextOk(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.ownerUid == null
            || request.resource.data.ownerUid == request.auth.uid);

      // The owner edits; or the holder of the number whose phone document
      // names this player claims it, in the same batch.
      allow update: if request.auth != null
        && request.resource.data.id == playerId
        && profileTextOk(request.resource.data)
        && photoOk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && ((resource.data.ownerUid == request.auth.uid
              && request.resource.data.ownerUid == request.auth.uid)
            || (request.resource.data.ownerUid == request.auth.uid
              && request.auth.token.phone_number != null
              && getAfter(phoneDocOf(request.auth.token.phone_number)).data.playerId == playerId
              && getAfter(phoneDocOf(request.auth.token.phone_number)).data.claimedBy == request.auth.uid));

      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // A number points at one player for good: the first to add it wins, and
    // a second captain's write is refused. Only the number's holder claims it.
    match /phones/{phoneId} {
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.playerId is string
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.createdBy == request.auth.uid
        && (!('claimedBy' in request.resource.data)
            || (request.resource.data.claimedBy == request.auth.uid && holdsNumber(phoneId)));

      allow update: if holdsNumber(phoneId)
        && request.resource.data.playerId == resource.data.playerId
        && request.resource.data.claimedBy == request.auth.uid;

      allow delete: if holdsNumber(phoneId);
    }

    // A team logo is the captain's own upload to the photos Worker.
    function logoOk(data, teamId) {
      return !('logoUrl' in data) || data.logoUrl == null
        || (data.logoUrl is string && data.logoUrl.size() <= 300
            && data.logoUrl.matches('https://[^/]+/img/teams/' + request.auth.uid + '/' + teamId + '[.]img([?]v=[0-9]+)?'));
    }

    // Teams a captain shared with an invite. Anyone may read them, so a join
    // code finds its team; only the captain changes one.
    match /teams/{teamId} {
      allow read: if true;

      allow create: if createsOwn()
        && request.resource.data.id == teamId
        && request.resource.data.players is list
        && request.resource.data.joinCode is string
        && logoOk(request.resource.data, teamId);

      allow update: if changesOwn()
        && request.resource.data.id == teamId
        && request.resource.data.players is list
        && request.resource.data.joinCode is string
        && logoOk(request.resource.data, teamId);

      allow delete: if deletesOwn();

      // A player asks to join, under the profile they own. The captain and
      // that player may read and remove the request; nobody else sees it.
      match /joins/{playerId} {
        function teamOwner() {
          return get(/databases/$(database)/documents/teams/$(teamId)).data.ownerUid == request.auth.uid;
        }
        function playerOwner() {
          return get(/databases/$(database)/documents/players/$(playerId)).data.ownerUid == request.auth.uid;
        }

        allow read, delete: if request.auth != null && (teamOwner() || playerOwner());

        allow create: if request.auth != null
          && playerOwner()
          && request.resource.data.playerId == playerId
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60;
      }
    }

    // A phone registered for push: its token and the kinds of update it
    // wants. Private to its owner; the Functions read it with admin rights.
    // The app sets testRequestedAt to ask for a test notification.
    match /pushDevices/{deviceId} {
      function deviceOk() {
        let d = request.resource.data;
        return d.token is string && d.token.size() < 4096
          && d.platform in ['android', 'ios']
          && d.kinds is map
          && (!('follows' in d) || (d.follows is list && d.follows.size() <= 50))
          && d.keys().hasOnly(['ownerUid', 'token', 'platform', 'kinds', 'follows', 'updatedAt', 'testRequestedAt']);
      }

      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if createsOwn() && deviceOk();
      allow update: if changesOwn() && deviceOk();
      allow delete: if deletesOwn();
    }

    // Ready-to-read copies of each match (a card for lists, the full view
    // for a match page), made by the server replaying the match with the
    // scoring engine (cloud/api). Anyone may read them, as they may the
    // match itself; only the server writes them, with its own account,
    // which these rules do not apply to.
    match /matchCards/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    match /matchViews/{matchId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed until a later step opens it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
