rules_version = '2';

// BNP Scorer security rules. Paste into Firebase console > Firestore Database >
// Rules, then Publish (README "Cloud"). Keep this file and the console in step.
//
// Published matches are public: anyone may read them. Only a signed-in scorer
// may publish a match, as its owner, and only that owner may change or delete
// it. Rules cannot run the scoring engine, so the app replays every match
// defensively; a bad owner can only spoil their own match.
service cloud.firestore {
  match /databases/{database}/documents {

    match /matches/{matchId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.setup.id == matchId
        && request.resource.data.events is list;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.setup.id == matchId
        && request.resource.data.events is list;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Everything else is closed until a later step opens it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
